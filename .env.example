# =====================================================================
# AGROHISOB CFO: ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AgroHisob CFO"
APP_VERSION="1.0.0-mvp"

# Backend API Configuration
API_V1_PREFIX=/api
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Next.js Configuration
PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# PostgreSQL Database Integration
# For local Docker: postgresql://agrohisob:agrohisob_secret@localhost:5432/agrohisob_db
# In development without Docker, system automatically falls back to local SQLite: sqlite:///./agrohisob_local.db
DATABASE_URL=postgresql://agrohisob:agrohisob_secret@localhost:5432/agrohisob_db
POSTGRES_USER=agrohisob
POSTGRES_PASSWORD=agrohisob_secret
POSTGRES_DB=agrohisob_db
POSTGRES_PORT=5432

# Security & Session Secrets (Replace with high-entropy cryptographic strings in production)
SECRET_KEY=agrohisob-dev-secret-key-uzbekistan-2026-agrifintech
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Uzbekistan Agro-Financial Regulatory Parameters
DEFAULT_CBU_POLICY_RATE=0.14        # Central Bank of Uzbekistan base refinancing rate (14.0%)
COMMERCIAL_LOAN_RATE=0.235          # Commercial bank average weighted rate for legal entities (23.5%)
PREFERENTIAL_AGRO_RATE=0.14         # State Agricultural Fund preferential financing rate (10-14%)
MIN_ACCEPTABLE_DSCR=1.25            # Banking standard for Debt Service Coverage Ratio
VMQ613_COLLATERAL_HAIRCUT=0.65      # Cabinet of Ministers Res. 613 leasehold collateral LTV haircut (65%)
